# =====================================================================
#  Variables de entorno de SIVER (backend)
#
#  Copia este archivo como .env y completa los valores.
#  El .env NO se sube al repositorio (esta en .gitignore).
#
#  En Tomcat estas mismas variables van en bin/setenv.sh (Linux) o
#  bin/setenv.bat (Windows). En Docker van en despliegue/docker/.env
# =====================================================================

# --- Base de datos ---
DB_HOST=localhost
DB_PORT=3306
DB_NAME=siver_bd
DB_USER=root
DB_PASSWORD=cambia-esta-clave

# --- JWT (minimo 32 caracteres) ---
JWT_SECRET=cambia-esta-clave-secreta-de-al-menos-32-caracteres
# 8 horas
JWT_EXPIRACION_MS=28800000

# --- CORS: desde donde se abre el frontend (separados por coma) ---
CORS_ORIGINS=http://localhost:4200

# --- Correo (opcional) ---
MAIL_HABILITADO=false
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USER=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=false
MAIL_STARTTLS=false
MAIL_FROM=siver@refricentro.pe

# --- Ver las consultas SQL en consola ---
SHOW_SQL=false
