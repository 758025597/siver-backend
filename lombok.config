config.stopBubbling = true

# @RequiredArgsConstructor copia estas anotaciones del atributo al parametro
# del constructor. Sin esto, un `@Qualifier("productoMapper") private final
# ModelMapper mapper;` se inyectaria sin el qualifier y Spring no sabria cual
# de los ModelMapper usar.
lombok.copyableAnnotations += org.springframework.beans.factory.annotation.Qualifier
