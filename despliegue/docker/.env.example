# =====================================================================
#  Variables del despliegue con Docker. Copia este archivo como .env
#  (docker compose lo lee solo) y cambia las claves.
#  El .env NO se sube al repositorio.
# =====================================================================

# --- MySQL ---
DB_ROOT_PASSWORD=cambia-la-clave-de-root
DB_NAME=siver_bd
DB_USER=siver_app
DB_PASSWORD=cambia-la-clave-de-la-app

# --- JWT (minimo 32 caracteres) ---
JWT_SECRET=cambia-esta-clave-secreta-de-al-menos-32-caracteres
JWT_EXPIRACION_MS=28800000

# --- CORS: el frontend se abre en http://localhost (puerto 80) ---
CORS_ORIGINS=http://localhost,http://127.0.0.1

# --- Correo de notificaciones (Mailpit) ---
MAIL_HABILITADO=true
MAIL_FROM=siver@refricentro.pe

# --- Puertos publicados en la PC ---
FRONTEND_PUERTO_HOST=80
BACKEND_PUERTO_HOST=8080
DB_PUERTO_HOST=3307
MAIL_PUERTO_WEB=8025
